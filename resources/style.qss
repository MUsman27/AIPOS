QMainWindow, QWidget {
    background: #f4f6f8;
    color: #1f2933;
    font-size: 14px;
}

QWidget#sidebar {
    background: #1f2933;
}

QPushButton#navToggle {
    background: transparent;
    color: #e4e7eb;
    border: none;
    border-radius: 8px;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    padding: 0;
    margin: 0;
}

QPushButton#navToggle:hover {
    background: #323f4b;
}

QPushButton#navButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0;
    margin: 0;
    min-width: 0;
    text-align: left;
}

QPushButton#navButton:hover {
    background: #323f4b;
}

QPushButton#navButton:checked {
    background: #3e4c59;
}

QWidget#sidebar QLabel#navIcon,
QWidget#sidebar QLabel#navLabel {
    background: transparent;
    color: #d9e2ec;
    padding: 0;
    margin: 0;
}

QPushButton#navButton:checked QLabel#navLabel {
    color: #ffffff;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 600;
    color: #102a43;
}

QLineEdit {
    background: white;
    border: 1px solid #cbd2d9;
    border-radius: 4px;
    padding: 6px 8px;
    min-height: 22px;
}

QLineEdit:focus {
    border: 1px solid #334e68;
}

QCheckBox {
    spacing: 8px;
}

QTableWidget {
    background: white;
    alternate-background-color: #f0f4f8;
    border: 1px solid #cbd2d9;
    gridline-color: #e4e7eb;
    selection-background-color: #d9e2ec;
    selection-color: #102a43;
}

QTableWidget::item:selected {
    background: #d9e2ec;
    color: #102a43;
}

QHeaderView::section {
    background: #e4e7eb;
    color: #243b53;
    padding: 6px;
    border: none;
    font-weight: 600;
}

QGroupBox {
    background: white;
    border: 1px solid #cbd2d9;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}

QPushButton {
    background: #243b53;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 14px;
    min-width: 72px;
}

QPushButton:hover {
    background: #334e68;
}

QPushButton:disabled {
    background: #9aa5b1;
    color: #f4f6f8;
}

QPushButton#dangerButton {
    background: #9b2335;
}

QPushButton#dangerButton:hover {
    background: #7a1b2a;
}
